amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Shared by the implicit `check`, `fix` and `pre-commit` hooks; pre-commit
// fixes, stages and stashes unstaged work by default.
steps {
  // File hygiene
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["end-of-file-fixer"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace

  // Python — the same tools `mise run lint:py` runs, on the staged files only
  ["black"] = Builtins.black
  ["ruff"] = Builtins.ruff
  ["codespell"] {
    glob = List("**/*.py", "**/*.md", "**/*.toml")
    exclude = List("**/*.lock")
    check = "codespell {{files}}"
  }

  // Config / CI
  ["taplo"] = Builtins.taplo
  ["yamllint"] = Builtins.yamllint
  ["actionlint"] = Builtins.actionlint
}
